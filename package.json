{
  "name": "hmlwsdk",
  "version": "0.1.0",
  "description": "HarmonyOS LiteWearable SDK",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "hmlwsdk": "bin/hmlwsdk.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "build:hap": "node bin/hmlwsdk.js packageReleaseHap",
    "build:app": "node bin/hmlwsdk.js packageReleaseApp",
    "build:signedApp": "node bin/hmlwsdk.js signReleaseApp"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "jsrsasign": "^11.1.1",
    "pako": "^1.0.11"
  },
  "keywords": [
    "harmonyos",
    "litewearable",
    "hap",
    "hmlw"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=18"
  }
}
